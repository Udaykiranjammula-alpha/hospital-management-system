{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "name": "medicare-hospital-management-system",
  "rewrites": [
    { "source": "/slides", "destination": "/slides.html" },
    { "source": "/presentation", "destination": "/presentation/slides.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/emergency", "destination": "/emergency.html" },
    { "source": "/telemedicine", "destination": "/telemedicine.html" },
    { "source": "/blood-bank", "destination": "/blood-bank.html" },
    { "source": "/patients", "destination": "/patients.html" },
    { "source": "/doctors", "destination": "/doctors.html" },
    { "source": "/appointments", "destination": "/appointments.html" },
    { "source": "/prescriptions", "destination": "/prescriptions.html" },
    { "source": "/laboratory", "destination": "/laboratory.html" },
    { "source": "/pharmacy", "destination": "/pharmacy.html" },
    { "source": "/billing", "destination": "/billing.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/patient-portal", "destination": "/patient-portal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
