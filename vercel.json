{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "name": "medicare-hospital-management-system",
  "rewrites": [
    { "source": "/slides", "destination": "/slides.html" },
    { "source": "/presentation", "destination": "/presentation/slides.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
